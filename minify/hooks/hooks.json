{
  "modules": ["./register.tsx"],
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/regels.sh\" start", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/regels.sh\" prompt", "timeout": 5 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/regels.sh\" subagent", "timeout": 5 }] }]
  }
}
