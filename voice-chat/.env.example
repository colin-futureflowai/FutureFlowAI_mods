# Alleen voor ontwikkelen: na installatie via de marketplace staan deze waarden in de
# plugin-instellingen (key in de keychain). Een waarde daar gaat voor op dit bestand.

# Inworld API key: de Base64 "Basic" credentials uit het Inworld Portal (zonder "Basic ")
INWORLD_API_KEY=

# Taal voor spraakherkenning en stem
LANGUAGE=nl

# Stem en model voor TTS (stem-ID's: Inworld Portal > Voices)
INWORLD_VOICE_ID=Dennis
INWORLD_TTS_MODEL=inworld-tts-2-flash

# Microfoon (naam uit: ffmpeg -f avfoundation -list_devices true -i "")
MIC_DEVICE=

# true = je mag Claude onderbreken door te praten (alleen met koptelefoon, anders hoort hij zichzelf)
BARGE_IN=false

# Model van de spraakagent (Inworld Realtime). Leeg: openai/gpt-4.1-mini
AGENT_MODEL=

# Mappen waar de spraakagent de CLAUDE.md als context krijgt (kommagescheiden). Leeg: nergens
AGENT_CONTEXT_ROOTS=
