# Alleen voor ontwikkelen: na installatie via de marketplace staan deze waarden in de
# plugin-instellingen (key in de keychain). Een waarde daar gaat voor op dit bestand.
# Vul zelf in wat je nodig hebt; een leeg veld gebruikt de standaard tussen haakjes.

# Inworld API key (verplicht): de Base64 "Basic" credentials uit het Inworld Portal (zonder "Basic ")
INWORLD_API_KEY=

# Taal voor spraakherkenning en stem (leeg: nl)
LANGUAGE=

# Stem voor de spraakagent en TTS, stem-ID uit Inworld Portal > Voices (leeg: Dennis)
INWORLD_VOICE_ID=

# TTS-model, alleen voor /voice voorlezen (leeg: inworld-tts-2-flash)
INWORLD_TTS_MODEL=

# Microfoon, naam uit: ffmpeg -f avfoundation -list_devices true -i "" (leeg: default)
MIC_DEVICE=

# true = je mag Claude onderbreken door te praten, alleen met koptelefoon (leeg: false)
BARGE_IN=

# Model van de spraakagent in Inworld Realtime (leeg: openai/gpt-4.1-mini)
AGENT_MODEL=

# Mappen waar de spraakagent bestandsnamen en CLAUDE.md als context krijgt, kommagescheiden (leeg: nergens)
AGENT_CONTEXT_ROOTS=
